<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#406D7A71" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/primary_pressed" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/primary" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
