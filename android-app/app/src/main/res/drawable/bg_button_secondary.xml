<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#20283C" /><stroke android:width="1dp" android:color="#3A4359" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface_raised" /><stroke android:width="1dp" android:color="@color/secondary_pressed" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/secondary" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
